# The dashboard driven the way an operator would: typing into the search
# box, picking results and pressing keys. Sources from scripts/e2e/config.toml.
type pa
wait 800
shot 1-results
# Build a plan from searches. Before the service starts, each add goes last.
type video
wait 800
select 1
wait 300
press ctrl+a
type pa
wait 800
select 1
wait 300
press ctrl+a
# A Bible reference: the live source's passage tops its group.
type juan 3:16-17
wait 800
select 1
wait 300
shot 2-bible-preview
press ctrl+a
# Start the plan: the video goes on program and plays.
press pagedown
wait 1000
press ctrl+space
type image
wait 800
select 1
wait 1500
shot 3-plan-preview-program
seek 5
wait 2500
shot 4-video-ended
press ctrl+b
wait 300
shot 5-blackout
press ctrl+b
press enter
wait 800
shot 6-took-preview
