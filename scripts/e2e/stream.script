# A YouTube video taken before its download is done streams at once while
# the download goes on (needs the network). Each run's cache starts empty,
# so the video is never downloaded already.
wait 1500
type !yt sublime gracia himno
press enter
wait 15000
select 7
wait 9000
shot 1-preview-streams
press enter
press ctrl+space
wait 6000
shot 2-on-stage-streaming
wait 4000
shot 3-still-playing
